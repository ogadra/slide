{
  "name": "cloudflare-workers-slidev",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/cloudflare-workers-slidev/slides-export",
    "build:slidev": "slidev build --base /cloudflare-workers-slidev/ --out ../../dist/slides/cloudflare-workers-slidev",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
