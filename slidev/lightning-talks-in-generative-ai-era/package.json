{
  "name": "lightning-talks-in-generative-ai-era",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/lightning-talks-in-generative-ai-era/slides-export",
    "build:slidev": "slidev build --base /lightning-talks-in-generative-ai-era/ --out ../../dist/slides/lightning-talks-in-generative-ai-era",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
