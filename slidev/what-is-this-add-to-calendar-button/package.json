{
  "name": "what-is-this-add-to-calendar-button",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/what-is-this-add-to-calendar-button/slides-export",
    "build:slidev": "slidev build --base /what-is-this-add-to-calendar-button/ --out ../../dist/slides/what-is-this-add-to-calendar-button",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
