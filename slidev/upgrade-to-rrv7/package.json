{
  "name": "upgrade-to-rrv7",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/upgrade-to-rrv7/slides-export",
    "build:slidev": "slidev build --base /upgrade-to-rrv7/ --out ../../dist/slides/upgrade-to-rrv7",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
