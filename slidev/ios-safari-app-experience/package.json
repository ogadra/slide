{
  "name": "ios-safari-app-experience",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/ios-safari-app-experience/slides-export",
    "build:slidev": "slidev build --base /ios-safari-app-experience/ --out ../../dist/slides/ios-safari-app-experience",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
