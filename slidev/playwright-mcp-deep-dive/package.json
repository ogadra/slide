{
  "name": "playwright-mcp-deep-dive",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/playwright-mcp-deep-dive/slides-export",
    "build:slidev": "slidev build --base /playwright-mcp-deep-dive/ --out ../../dist/slides/playwright-mcp-deep-dive",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
