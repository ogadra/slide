{
  "name": "fargate-as-sandbox",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/fargate-as-sandbox/slides-export",
    "build:slidev": "slidev build --base /fargate-as-sandbox/ --out ../../dist/slides/fargate-as-sandbox",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
