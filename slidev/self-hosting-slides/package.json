{
  "name": "self-hosting-slides",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/self-hosting-slides/slides-export",
    "build:slidev": "slidev build --base /self-hosting-slides/ --out ../../dist/slides/self-hosting-slides",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
