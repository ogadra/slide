{
  "name": "solo-dev-considerations",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/solo-dev-considerations/slides-export",
    "build:slidev": "slidev build --base /solo-dev-considerations/ --out ../../dist/slides/solo-dev-considerations",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
