{
  "name": "using-conform-in-remix",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/using-conform-in-remix/slides-export",
    "build:slidev": "slidev build --base /using-conform-in-remix/ --out ../../dist/slides/using-conform-in-remix",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
