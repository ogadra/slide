{
  "name": "dai-kichijoji-pm-2026-teaser-talk",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:copy",
    "build:copy": "cp -r ./slides-export ../../dist/slides/dai-kichijoji-pm-2026-teaser-talk",
    "build:slidev": "slidev build --base /dai-kichijoji-pm-2026-teaser-talk/ --out ../../dist/slides/dai-kichijoji-pm-2026-teaser-talk",
    "dev": "slidev --open",
    "export": "slidev export",
    "export:png": "slidev export --format png"
  }
}
