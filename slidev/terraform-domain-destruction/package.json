{
  "name": "terraform-domain-destruction",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/terraform-domain-destruction/slides-export",
    "build:slidev": "slidev build --base /terraform-domain-destruction/ --out ../../dist/slides/terraform-domain-destruction",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
