{
  "name": "cost-and-access-log-report",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/cost-and-access-log-report/slides-export",
    "build:slidev": "slidev build --base /cost-and-access-log-report/ --out ../../dist/slides/cost-and-access-log-report",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
