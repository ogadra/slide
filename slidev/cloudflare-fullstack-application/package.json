{
  "name": "cloudflare-fullstack-application",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/cloudflare-fullstack-application/slides-export",
    "build:slidev": "slidev build --base /cloudflare-fullstack-application/ --out ../../dist/slides/cloudflare-fullstack-application",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
