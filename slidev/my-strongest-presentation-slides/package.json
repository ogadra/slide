{
  "name": "my-strongest-presentation-slides",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0"
  },
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --timeout 120000 --output ../../dist/slides/my-strongest-presentation-slides/slides-export",
    "build:slidev": "slidev build --base /my-strongest-presentation-slides/ --out ../../dist/slides/my-strongest-presentation-slides",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
