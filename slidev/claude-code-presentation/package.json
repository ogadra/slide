{
  "name": "claude-code-presentation",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "author": "ogadra",
  "scripts": {
    "build": "pnpm run build:slidev && pnpm run build:png",
    "build:png": "slidev export --format png --output ../../dist/slides/claude-code-presentation/slides-export",
    "build:slidev": "slidev build --base /claude-code-presentation/ --out ../../dist/slides/claude-code-presentation",
    "dev": "slidev --open",
    "export": "slidev export"
  }
}
