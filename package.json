{
  "name": "slide",
  "type": "module",
  "version": "0.0.1",
  "description": "ogadra's slides website.",
  "author": "ogadra",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run generate && vitest run",
    "e2e:fixture": "pnpm run generate && node scripts/e2eFixture.ts",
    "e2e": "pnpm run e2e:fixture && node node_modules/@playwright/test/cli.js test",
    "sync:prd": "node scripts/syncAssets.ts prd",
    "sync:dev": "node scripts/syncAssets.ts dev",
    "sync:local": "node scripts/syncAssets.ts local",
    "dev": "pnpm run generate && pnpm run sync:local && wrangler dev --ip 0.0.0.0 --env dev",
    "start": "pnpm run generate && pnpm run sync:local && wrangler dev --ip 0.0.0.0 --env dev",
    "generate": "pnpm --filter slide-home run generate",
    "generate:types": "wrangler types --config wrangler.jsonc home/worker-configuration.d.ts",
    "deploy:prd": "pnpm run build && pnpm run sync:prd && wrangler deploy --env=\"\"",
    "deploy:dev": "pnpm run build && pnpm run sync:dev && wrangler deploy --env dev"
  },
  "private": true,
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "1.60.0",
    "@slidev/cli": "^52.19.1",
    "@slidev/client": "^52.19.1",
    "playwright-chromium": "^1.59.1",
    "slidev-theme-purplin": "^1.2.0",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "vue-i18n": "^11.4.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright-chromium",
      "sharp",
      "vue-demi",
      "workerd"
    ]
  }
}
