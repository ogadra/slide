{
  "name": "slide",
  "type": "module",
  "version": "0.0.1",
  "description": "ogadra's slides website.",
  "author": "ogadra",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "sync:prd": "node scripts/syncAssets.ts prd",
    "sync:dev": "node scripts/syncAssets.ts dev",
    "sync:local": "node scripts/syncAssets.ts local",
    "dev": "pnpm run generate && pnpm run sync:local && wrangler dev --ip 0.0.0.0 --env dev",
    "start": "pnpm run generate && pnpm run sync:local && wrangler dev --ip 0.0.0.0 --env dev",
    "generate": "pnpm --filter slide-home run generate",
    "deploy:prd": "pnpm run build && pnpm run sync:prd && wrangler deploy --env=\"\"",
    "deploy:dev": "pnpm run build && pnpm run sync:dev && wrangler deploy --env dev"
  },
  "private": true,
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.1",
    "@slidev/cli": "^52.16.0",
    "@slidev/client": "^52.17.0",
    "playwright-chromium": "^1.59.1",
    "slidev-theme-purplin": "^1.2.0",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vue": "^3.5.33",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "vue-i18n": "^11.4.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright-chromium",
      "sharp",
      "vue-demi",
      "workerd"
    ],
    "patchedDependencies": {
      "@slidev/client@52.16.0": "patches/@slidev__client@52.16.0.patch"
    }
  }
}
