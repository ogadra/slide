{
  "name": "slide-home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generateManifest.ts",
    "dev": "pnpm run generate && vite",
    "dev:cf": "pnpm run generate && wrangler dev --ip 0.0.0.0",
    "build": "pnpm run generate && mkdir -p ../dist/home/assets && cp assets/style.css ../dist/home/assets/style.css",
    "preview": "pnpm run generate && vite preview",
    "export:png": "",
    "lint": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "typecheck": "pnpm run generate && tsc --noEmit"
  },
  "dependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "bcrypt-ts": "^8.0.1",
    "hono": "^4.13.2",
    "nanoid": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cloudflare/sandbox": "^0.11.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
